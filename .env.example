# 📧 Email Configuration (Fastmail)
FASTMAIL_USER=your-email@fastmail.com
FASTMAIL_PASS=your-app-specific-password

# 🔔 Discord Webhook Configuration (Required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# 📊 Massive API Configuration (Optional)
# Get your API key from https://massive.com/dashboard/api-keys
# Used for company names. Without it, company names are omitted from alerts.
# The legacy name POLYGON_API_KEY still works.
MASSIVE_API_KEY=your-massive-api-key

# 🔍 Sentry Error Tracking (Optional)
# If you want to track errors and exceptions with Sentry.io:
# 1. Sign up at https://sentry.io
# 2. Create a new project (select Python)
# 3. Copy the DSN from your project settings
# 4. Optionally configure the environment and sample rate
#
# SENTRY_DSN=https://your-project-key@your-org.sentry.io/your-project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1.0

# 🔧 Optional Configuration
# LOG_LEVEL=INFO
# IMAP_HOST=imap.fastmail.com
# IMAP_PORT=993
# IMAP_FOLDER=Trading/ToS Alerts
